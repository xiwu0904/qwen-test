# Aliyun DashScope API Key
# Get your API key from: https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=sk-your-api-key-here

# Region Selection (uncomment one)
# Beijing region (default)
API_REGION=beijing

# Singapore region
# API_REGION=singapore

# Proxy Settings (optional, uncomment if needed)
# If you're behind a corporate firewall or need to use a proxy
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
